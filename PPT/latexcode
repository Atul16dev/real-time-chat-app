\begin{frame}{Features of the Chat Application}

\begin{enumerate}

\item \textbf{User Signup and Login}
\begin{itemize}
\item Users can create accounts and log in securely.
\end{itemize}

\item \textbf{Real-time Messaging}
\begin{itemize}
\item Messages are delivered instantly using Socket.io.
\end{itemize}

\item \textbf{Image Sharing}
\begin{itemize}
\item Users can share images within the chat.
\end{itemize}

\item \textbf{Online / Offline Status}
\begin{itemize}
\item Users can see whether others are online or offline.
\end{itemize}

\item \textbf{Profile Editing}
\begin{itemize}
\item Users can update profile information and images.
\end{itemize}

\item \textbf{Unseen Message Notification}
\begin{itemize}
\item Users receive notifications for unread messages.
\end{itemize}

\item \textbf{Responsive UI}
\begin{itemize}
\item The application works smoothly on mobile and desktop devices.
\end{itemize}

\end{enumerate}

\end{frame}
\begin{frame}{Backend Implementation}

\begin{itemize}
\vspace{-1cm}
\item Built using \textbf{Node.js} and \textbf{Express.js}

\item REST APIs for authentication and messaging

\item Passwords secured using \textbf{bcryptjs}

\item \textbf{JWT} used for user authentication

\end{itemize}

\vspace{0.5cm}

\textbf{Main API Endpoints}

\begin{itemize}

\item \texttt{/signup} – User registration

\item \texttt{/login} – User login

\item \texttt{/messages} – Send / receive messages

\item \texttt{/profile} – Manage user profile

\end{itemize}

\end{frame}
\begin{frame}{Real-Time Communication (Socket.io)}
\vspace{-0.5cm}
\begin{block}{Key Concept}
\begin{itemize}
\item Enables \textbf{bidirectional communication} between client and server
\item Server keeps track of \textbf{online users}
\item Messages are delivered \textbf{instantly} without page refresh
\end{itemize}
\end{block}

\vspace{0.5cm}

\begin{exampleblock}{Socket Events}
\begin{itemize}
\item \texttt{connect} -- User connects to the server
\item \texttt{new message} -- Send and receive messages
\item \texttt{disconnect} -- User leaves the chat
\end{itemize}
\end{exampleblock}

\end{frame}
